class Wheredns < Formula
  desc "DNS, email, web and network diagnostics from the terminal"
  homepage "https://github.com/Shroomate/wheredns-cli"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/Shroomate/wheredns-cli/releases/download/v@VERSION@/wheredns-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/Shroomate/wheredns-cli/releases/download/v@VERSION@/wheredns-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/Shroomate/wheredns-cli/releases/download/v@VERSION@/wheredns-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "wheredns"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/wheredns --version")
    assert_match "theme", shell_output("#{bin}/wheredns config")
  end
end
