# Template only. Replace every token with verified release artifact metadata.
class Wheredns < Formula
  desc "Local network diagnostics"
  homepage "https://github.com/Shroomate/wheredns-cli"
  version "@VERSION@"
  on_macos do
    if Hardware::CPU.arm?
      url "@MACOS_ARM64_ARCHIVE_URL@"
      sha256 "@MACOS_ARM64_SHA256@"
    else
      url "@MACOS_X86_64_ARCHIVE_URL@"
      sha256 "@MACOS_X86_64_SHA256@"
    end
  end
  on_linux do
    url "@LINUX_X86_64_ARCHIVE_URL@"
    sha256 "@LINUX_X86_64_SHA256@"
  end
  def install
    bin.install "wheredns"
  end
  test do
    assert_match version.to_s, shell_output("#{bin}/wheredns --version")
  end
end
